{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviebox-apil",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
